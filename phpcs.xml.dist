<?xml version="1.0"?>
<ruleset name="NExT Custom Field Link Button Block">
	<description>Custom ruleset for NExT Custom Field Link Button Block</description>

	<!-- 対象ファイル -->
	<file>./next-custom-field-link-button-block.php</file>
	<file>./src/render.php</file>

	<!-- 除外 -->
	<exclude-pattern>./vendor/*</exclude-pattern>
	<exclude-pattern>./node_modules/*</exclude-pattern>
	<exclude-pattern>./build/*</exclude-pattern>
	<exclude-pattern>./tests/*</exclude-pattern>

	<!-- WordPress Coding Standards -->
	<rule ref="WordPress">
		<!-- render.php はブロックのテンプレートとして WP core から $attributes/$content/$block を渡されるため、グローバル変数プレフィックスの規約は対象外とする -->
		<exclude name="WordPress.NamingConventions.PrefixAllGlobals" />
		<!-- 本プロジェクトのコメントは日本語のみのため、DocComment の要約が半角大文字で始まる規約は対象外とする -->
		<exclude name="Generic.Commenting.DocComment.ShortNotCapital" />
	</rule>

	<!-- PHP互換性チェック -->
	<rule ref="PHPCompatibilityWP" />

	<!-- PHP バージョン -->
	<config name="testVersion" value="7.4-" />

	<!-- テキストドメイン -->
	<config name="text_domain" value="next-custom-field-link-button-block" />

	<!-- プレフィックス -->
	<config name="prefixes" value="next_custom_field_link_button_block" />
	<config name="minimum_wp_version" value="6.1" />
</ruleset>
